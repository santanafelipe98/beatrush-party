# Copie para .env.local e ajuste. Tudo é opcional.

# Porta do servidor (padrão 3000)
PORT=3000

# Catálogo de músicas: deezer (padrão) | mock (offline, sem áudio)
MUSIC_PROVIDER=deezer

# --- Redis (opcional) ---------------------------------------------------------
# Sem REDIS_URL: tudo em memória (salas se perdem ao reiniciar o servidor).
# Com REDIS_URL: salas e cache de músicas no Redis; partidas sobrevivem a reinícios.
# Suba um Redis local com:  npm run redis:up
# REDIS_URL=redis://localhost:6379
# REDIS_PREFIX=beatrush:        # prefixo das chaves (útil ao compartilhar o Redis)
# ROOM_TTL_SECONDS=21600        # validade de uma sala sem atividade no Redis (6h)
# ROOM_IDLE_MS=1800000          # remove a sala após 30 min sem nenhuma conexão

# --- Ajustes de partida (úteis em testes) ---
# VOTE_MS=20000
# ROUND_MS=10000
# REVEAL_MS=5000
# TOTAL_ROUNDS=12
